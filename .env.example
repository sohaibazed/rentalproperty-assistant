# Names only. Do NOT put real values in this file or in git.
# Load real values from a secrets manager at runtime, e.g.:
#   op run --env-file=.env.example -- make sync-email      (1Password CLI, values as op:// refs)
# or export them from macOS Keychain in your shell profile.

# Claude API key used by the Agent SDK
ANTHROPIC_API_KEY=

# Postgres connection string for the least-privilege `rental_agent` role
# (Supabase > Project Settings > Database > Connection string, user = rental_agent)
RENTAL_DB_URL=

# Gmail OAuth: client secrets file and where the read-only token is cached (outside the repo)
GMAIL_CLIENT_SECRETS=~/.config/rental-agent/gmail_client.json
GMAIL_TOKEN_PATH=~/.config/rental-agent/gmail.token.json

# Optional overrides
RENTAL_AGENT_MODEL=claude-opus-5-5
RENTAL_ARTIFACTS_DIR=./artifacts
RENTAL_REFERENCE_DIR=./reference
RENTAL_EMAIL_SOURCES=./config/email_sources.toml
